# Configuración de la app web de Firebase
API_KEY=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
MESSAGING_SENDER_ID=
APP_ID=

# Secreto aleatorio para firmar JWT (mínimo 32 caracteres). Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANTINA_TOKEN=

# Rol con permisos de administración
ROL_ADMIN=admin

# Origen exacto del frontend (sin barra final). Obligatorio: se usa para CORS
# y para armar el link de recuperación de contraseña.
FRONTEND_URL=http://localhost:5173
PORT=3000

# Solo en producción detrás de un proxy de confianza (Render): 1 o true.
# TRUST_PROXY=1

# Contraseña del usuario admin creado por seed.js (mínimo 12 caracteres).
# Solo hace falta al ejecutar el seed por primera vez; no subirla al repo.
ADMIN_SEED_PASSWORD=

# Envío de emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_API_URL=https://api.resend.com
CONTACT_TO_EMAIL=hola@todosalagua.com.ar
